ANTHROPIC_API_KEY=

# Secret key signing login sessions. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this value across environments, never commit a real one.
JWT_SECRET=

# --- Production (Docker Compose) ---------------------------------------

# Postgres password for the `db` service. Leave unset for the "echotrace"
# dev default (fine for local Docker use, change it for anything else).
POSTGRES_PASSWORD=

# Comma-separated list of origins the backend accepts requests from. The
# bundled frontend talks to the backend same-origin via nginx's reverse
# proxy, so this only needs to list *other* origins you actually use
# (e.g. a separately hosted frontend, or localhost during development).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host port the frontend container is published on (docker-compose.yml).
FRONTEND_PORT=8080

# Set this and run `docker compose --profile domain up -d` to bring up the
# optional Caddy reverse proxy with automatic HTTPS for a real domain
# pointed at this host. Leave unset for local/plain-HTTP use. See
# DEPLOYMENT.md.
DOMAIN=

# Not used directly by the app outside Docker; DATABASE_URL below is what
# src/echotrace/db.py actually reads. Left unset, it falls back to a local
# SQLite file — fine for zero-setup dev, not for concurrent production use.
# Docker Compose sets this to the bundled Postgres service automatically.
# DATABASE_URL=postgresql+psycopg://echotrace:<password>@localhost:5432/echotrace
